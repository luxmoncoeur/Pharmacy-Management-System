{
  "name": "pharmacy-management-system",
  "version": "1.0.0",
  "description": "Multi-branch Pharmacy Management System with POS, batch and expiry inventory, prescriptions, and reports.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node scripts/db-setup.js",
