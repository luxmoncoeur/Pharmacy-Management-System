    "lint": "eslint .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
